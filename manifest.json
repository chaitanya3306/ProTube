{
  "manifest_version": 3,
  "name": "ProTube: Productive YouTube",
  "version": "2.0.0",
  "description": "A focused YouTube feed with topic-based discovery, Shorts controls, and distraction-reducing tools.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "YT Focus Feed",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "js/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "js/constants.js",
        "js/presets.js",
        "js/storage.js",
        "js/clickbait.js",
        "js/scoring.js",
        "js/content.js"
      ],
      "css": [
        "css/content.css"
      ],
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.googleapis.com/*",
    "https://www.youtube.com/*",
    "https://youtube.com/*"
  ],
  "optional_host_permissions": [
    "https://api.openai.com/*"
  ]
}
